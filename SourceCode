def _normalize_category(category: str) -> str:
    c = str(category).strip().lower()
    if c == "binaural":
        return "Binaural"
    if c == "monaural":
        return "Monaural"
    raise ValueError("Category must be 'Monaural' or 'Binaural'")


def get_user_presets() -> dict:
    up = config.get("user_presets", {})
    return {
        "Monaural": list(up.get("Monaural", [])),
        "Binaural": list(up.get("Binaural", [])),
    }


def add_user_preset(category: str, label: str, left_hz: float, right_hz: float) -> None:
    category = _normalize_category(category)

    try:
        preset_obj = {
            "label": str(label).strip(),
            "left_hz": float(left_hz),
            "right_hz": float(right_hz),
        }
    except ValueError:
        raise ValueError("Invalid numeric value for frequencies.")
    if not preset_obj["label"]:
        raise ValueError("Preset Name Cannot be Empty")

    up = get_user_presets()
    up[category].append(preset_obj)

    config["user_presets"] = up
    save_config(config)


def remove_user_preset(category: str, label: str) -> bool:
    category = _normalize_category(category)

    up = get_user_presets()
    label = str(label).strip()

    for i, p in enumerate(up[category]):
        if str(p.get("label", "")).strip() == label:
            up[category].pop(i)
            config["user_presets"] = up
            save_config(config)
            return True

    return False


def get_all_presets() -> dict:
    up = get_user_presets()
    return {
        "Monaural": list(presets.MONAURAL_PRESETS) + up["Monaural"],
        "Binaural": list(presets.BINAURAL_PRESETS) + up["Binaural"],
    }


def clamp(value, lo, hi):
    return max(lo, min(hi, value))


def _compute_ramped_beat_hz(elapsed_s: float, start_beat_hz: float, end_beat_hz: float, ramp_s: float) -> float:
    if ramp_s <= 0:
        return end_beat_hz
    x = clamp(elapsed_s / ramp_s, 0.0, 1.0)
    return start_beat_hz + (end_beat_hz - start_beat_hz) * x


@dataclass
class AudioConfig:
    sample_rate: int
    left_volume: float
    right_volume: float
    left_waveform: str
    right_waveform: str
    use_ramp: bool
    left_frequency: float
    right_frequency: float
    carrier_hz: float
    start_beat_hz: float
    end_beat_hz: float
    ramp_minutes: float


class BinauralGenerator:
    def __init__(self, cfg: AudioConfig):
        self.cfg = cfg
        self.phase_l = 0.0
        self.phase_r = 0.0
        self.samples_generated = 0
        self.ramp_s = max(0.0, float(cfg.ramp_minutes) * 60.0)
        self.left_wave_func = waveforms[cfg.left_waveform]
        self.right_wave_func = waveforms[cfg.right_waveform]
        self.drive = 2.5
        self.tanh_drive = np.tanh(self.drive)

    def generate_block(self, frames: int) -> np.ndarray:
        # Time array for this block
        t = np.arange(frames, dtype=np.float32) / self.cfg.sample_rate

        # Calculate current time in seconds based on samples generated
        current_time = self.samples_generated / self.cfg.sample_rate

        if self.cfg.use_ramp:
            beat_hz = _compute_ramped_beat_hz(current_time, self.cfg.start_beat_hz, self.cfg.end_beat_hz, self.ramp_s)
            lf = self.cfg.carrier_hz - (beat_hz / 2.0)
            rf = self.cfg.carrier_hz + (beat_hz / 2.0)
        else:
            lf = self.cfg.left_frequency
            rf = self.cfg.right_frequency

        lf = max(0.0, float(lf))
        rf = max(0.0, float(rf))

        wl = np.float32(2.0 * np.pi * lf)
        wr = np.float32(2.0 * np.pi * rf)

        # Calculate phase vectors starting from current phase
        phase_vec_l = np.float32(self.phase_l) + wl * t
        phase_vec_r = np.float32(self.phase_r) + wr * t

        # Update accumulated phase for next block
        block_duration = frames / self.cfg.sample_rate
        self.phase_l = (self.phase_l + wl * block_duration) % (2.0 * np.pi)
        self.phase_r = (self.phase_r + wr * block_duration) % (2.0 * np.pi)

        left = self.cfg.left_volume * self.left_wave_func(phase_vec_l)
        right = self.cfg.right_volume * self.right_wave_func(phase_vec_r)

        stereo = np.column_stack((left, right))

        # Stateless soft limiter/saturator
        # Preserves the saturation character of the original but avoids per-block pumping.
        stereo = np.tanh(stereo * self.drive) / self.tanh_drive
        stereo = np.clip(stereo, -1.0, 1.0)

        self.samples_generated += frames
        return stereo.astype(np.float32, copy=False)


def _start_stream(cfg: AudioConfig):
    global stream

    try:
        if stream is not None:
            stop_audio()

        generator = BinauralGenerator(cfg)

        def callback(outdata, frames, _time_info, status):
            if status:
                logger.warning(f"Audio status: {status}")
            try:
                outdata[:] = generator.generate_block(frames)
            except Exception:
                logger.error("Error in audio callback", exc_info=True)
                # Output silence in case of error to prevent garbage
                outdata.fill(0)

        stream = sd.OutputStream(
            samplerate=cfg.sample_rate,
            channels=2,
            dtype="float32",
            callback=callback,
            blocksize=0
        )
        stream.start()
        logger.info("Audio stream started")
    except Exception:
        logger.error("Failed to start audio stream", exc_info=True)
        messagebox.showerror("Audio Error", "Failed to start audio stream. See logs for details.")


def validate_audio_params(freq_l, freq_r, vol_l, vol_r, duration=None):
    if not (1.0 <= freq_l <= 1000.0):
        return "Frequency must be between 1 Hz and 1000 Hz."
    if not (1.0 <= freq_r <= 1000.0):
        return "Frequency must be between 1 Hz and 1000 Hz."
    if not (0.0 <= vol_l <= 100.0):
        return "Volume must be between 0% and 100%."
    if not (0.0 <= vol_r <= 100.0):
        return "Volume must be between 0% and 100%."
    if duration is not None and duration <= 0:
        return "Duration must be positive."
    return None


def export_audio_file():
    stop_audio()

    try:
        # Get parameters from UI
        try:
            left_volume = float(left_volume_entry.get())
            right_volume = float(right_volume_entry.get())
        except ValueError:
            messagebox.showerror("Input Error", "Invalid volume values.")
            return

        left_vol_norm = clamp(left_volume / 100.0, 0.0, 1.0)
        right_vol_norm = clamp(right_volume / 100.0, 0.0, 1.0)

        left_waveform = left_waveform_var.get()
        right_waveform = right_waveform_var.get()
        use_ramp = bool(ramp_enabled_var.get())

        sample_rate = 44100

        if use_ramp:
            try:
                ramp_carrier_hz = float(carrier_entry.get())
                ramp_start_beat_hz = float(start_beat_entry.get())
                ramp_end_beat_hz = float(end_beat_entry.get())
                ramp_minutes = float(ramp_minutes_entry.get())
            except ValueError:
                messagebox.showerror("Input Error", "Invalid ramp parameters.")
                return

            ramp_duration_s = max(0.0, ramp_minutes * 60.0)

            # Basic validation for ramp
            if not (1.0 <= ramp_carrier_hz <= 1000.0):
                 messagebox.showerror("Input Error", "Carrier frequency must be between 1 Hz and 1000 Hz.")
                 return

            cfg = AudioConfig(
                sample_rate=sample_rate,
                left_volume=left_vol_norm,
                right_volume=right_vol_norm,
                left_waveform=left_waveform,
                right_waveform=right_waveform,
                use_ramp=True,
                left_frequency=0.0,
                right_frequency=0.0,
                carrier_hz=ramp_carrier_hz,
                start_beat_hz=ramp_start_beat_hz,
                end_beat_hz=ramp_end_beat_hz,
                ramp_minutes=ramp_minutes
            )
            default_duration = ramp_duration_s
        else:
            try:
                manual_left_hz = float(left_frequency_entry.get())
                manual_right_hz = float(right_frequency_entry.get())
            except ValueError:
                messagebox.showerror("Input Error", "Invalid frequency values.")
                return

            err = validate_audio_params(manual_left_hz, manual_right_hz, left_volume, right_volume)
            if err:
                messagebox.showerror("Input Error", err)
                return

            cfg = AudioConfig(
                sample_rate=sample_rate,
                left_volume=left_vol_norm,
                right_volume=right_vol_norm,
                left_waveform=left_waveform,
                right_waveform=right_waveform,
                use_ramp=False,
                left_frequency=manual_left_hz,
                right_frequency=manual_right_hz,
                carrier_hz=0.0,
                start_beat_hz=0.0,
                end_beat_hz=0.0,
                ramp_minutes=0.0
            )
            default_duration = 300.0 # 5 mins default

        duration_str = simpledialog.askstring("Export Audio", f"Enter duration in seconds:", initialvalue=str(int(default_duration)))
        if not duration_str:
            return

        try:
            duration = float(duration_str)
            if duration <= 0:
                raise ValueError
        except ValueError:
            messagebox.showerror("Input Error", "Duration must be a positive number.")
            return

        filename = filedialog.asksaveasfilename(
            title="Export WAV",
            defaultextension=".wav",
            filetypes=[("WAV files", "*.wav")]
        )
        if not filename:
            return

        # Progress Window
        progress_win = tb.Toplevel(root)
        progress_win.title("Exporting...")
        progress_win.geometry("300x100")

        progress_label = ttk.Label(progress_win, text="Generating audio...")
        progress_label.pack(pady=10)
        progress_bar = ttk.Progressbar(progress_win, mode='determinate')
        progress_bar.pack(fill=tk.X, padx=20, pady=10)

        root.update()

        generator = BinauralGenerator(cfg)
        total_frames = int(duration * sample_rate)
        block_size = 4096

        frames_written = 0
        all_audio = []

        try:
            while frames_written < total_frames:
                chunk_size = min(block_size, total_frames - frames_written)
                audio_block = generator.generate_block(chunk_size)
                all_audio.append(audio_block)
                frames_written += chunk_size

                # Update progress
                percent = (frames_written / total_frames) * 100
                progress_bar['value'] = percent
                progress_win.update()

            full_audio = np.concatenate(all_audio)

            wavfile.write(filename, sample_rate, full_audio)

            logger.info(f"Exported audio to {filename}")
            messagebox.showinfo("Export Complete", f"Saved to {filename}")
        except Exception as e:
            logger.error("Export failed", exc_info=True)
            messagebox.showerror("Export Error", f"Export failed: {str(e)}")
        finally:
            progress_win.destroy()

    except Exception as e:
        logger.error("Export initialization failed", exc_info=True)
        messagebox.showerror("Export Error", str(e))


def play_audio():
    global is_playing
    global play_mode, play_start_time
    global ramp_carrier_hz, ramp_start_beat_hz, ramp_end_beat_hz, ramp_duration_s
    global manual_left_hz, manual_right_hz
    global live_status_after_id

    try:
        if is_playing:
            stop_audio()

        sample_rate = 44100

        try:
            left_volume_val = float(left_volume_entry.get())
            right_volume_val = float(right_volume_entry.get())
        except ValueError:
             messagebox.showerror("Input Error", "Please enter valid numeric values for volume.")
             return

        left_volume = clamp(left_volume_val / 100.0, 0.0, 1.0)
        right_volume = clamp(right_volume_val / 100.0, 0.0, 1.0)

        left_waveform = left_waveform_var.get()
        right_waveform = right_waveform_var.get()

        use_ramp = bool(ramp_enabled_var.get())
        play_start_time = time.time()

        if use_ramp:
            play_mode = "ramp"

            try:
                ramp_carrier_hz = float(carrier_entry.get())
                ramp_start_beat_hz = float(start_beat_entry.get())
                ramp_end_beat_hz = float(end_beat_entry.get())
                ramp_minutes = float(ramp_minutes_entry.get())
            except ValueError:
                messagebox.showerror("Input Error", "Please enter valid numeric values for ramp settings.")
                return

            if not (1.0 <= ramp_carrier_hz <= 1000.0):
                 messagebox.showerror("Input Error", "Carrier frequency must be between 1 Hz and 1000 Hz.")
                 return

            ramp_duration_s = max(0.0, ramp_minutes * 60.0)

            beat_now = ramp_start_beat_hz
            left_frequency_entry.delete(0, tk.END)
            right_frequency_entry.delete(0, tk.END)
            left_frequency_entry.insert(0, str(ramp_carrier_hz - beat_now / 2.0))
            right_frequency_entry.insert(0, str(ramp_carrier_hz + beat_now / 2.0))

            cfg = AudioConfig(
                sample_rate=sample_rate,
                left_volume=left_volume,
                right_volume=right_volume,
                left_waveform=left_waveform,
                right_waveform=right_waveform,
                use_ramp=True,
                left_frequency=0.0,
                right_frequency=0.0,
                carrier_hz=ramp_carrier_hz,
                start_beat_hz=ramp_start_beat_hz,
                end_beat_hz=ramp_end_beat_hz,
                ramp_minutes=(ramp_duration_s / 60.0)
            )
            _start_stream(cfg)
        else:
            play_mode = "manual"

            try:
                manual_left_hz = float(left_frequency_entry.get())
                manual_right_hz = float(right_frequency_entry.get())
            except ValueError:
                messagebox.showerror("Input Error", "Please enter valid numeric values for frequencies.")
                return

            err = validate_audio_params(manual_left_hz, manual_right_hz, left_volume_val, right_volume_val)
            if err:
                messagebox.showerror("Input Error", err)
                return

            cfg = AudioConfig(
                sample_rate=sample_rate,
                left_volume=left_volume,
                right_volume=right_volume,
                left_waveform=left_waveform,
                right_waveform=right_waveform,
                use_ramp=False,
                left_frequency=manual_left_hz,
                right_frequency=manual_right_hz,
                carrier_hz=0.0,
                start_beat_hz=0.0,
                end_beat_hz=0.0,
                ramp_minutes=0.0
            )
            _start_stream(cfg)

        is_playing = True

        if live_status_after_id is None:
            update_live_status()
    except Exception as e:
        logger.error("Error playing audio", exc_info=True)
        messagebox.showerror("Error", f"An unexpected error occurred: {e}")


def stop_audio():
    global is_playing, stream
    global play_mode
    global live_status_after_id

    # Stop UI update loop
    if live_status_after_id is not None:
        try:
            root.after_cancel(live_status_after_id)
        except Exception:
            logger.error("Error cancelling live status update", exc_info=True)
        live_status_after_id = None

    if stream is not None:
        try:
            stream.stop()
        except Exception:
            logger.error("Error stopping audio stream", exc_info=True)
        try:
            stream.close()
        except Exception:
            logger.error("Error closing audio stream", exc_info=True)
        stream = None
        logger.info("Audio stopped")

    is_playing = False
    play_mode = "manual"


