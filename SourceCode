manual_right_hz = 432.0

waveforms = {
    "Sine": np.sin,
    "Square": signal.square,
    "Sawtooth": signal.sawtooth,
}

def clamp(value, lo, hi):
    return max(lo, min(hi, value))

def soft_limiter(stereo_audio: np.ndarray, drive: float = 2.5) -> np.ndarray:
    limited = np.tanh(stereo_audio * drive) / np.tanh(drive)

    peak = float(np.max(np.abs(limited)))
    if peak > 1.0:
        limited = limited / peak

    return limited

def _compute_ramped_beat_hz(elapsed_s: float, start_beat_hz: float, end_beat_hz: float, ramp_s: float) -> float:
    if ramp_s <= 0:
        return end_beat_hz
    x = clamp(elapsed_s / ramp_s, 0.0, 1.0)
    return start_beat_hz + (end_beat_hz - start_beat_hz) * x

def _start_stream(
    sample_rate: int,
    left_volume: float,
    right_volume: float,
    left_waveform: str,
    right_waveform: str,
    use_ramp: bool,
    left_frequency: float,
    right_frequency: float,
    carrier_hz: float,
    start_beat_hz: float,
    end_beat_hz: float,
    ramp_minutes: float
):
    global stream

    ramp_s = max(0.0, float(ramp_minutes) * 60.0)

    phase_l = 0.0
    phase_r = 0.0
    start_time = time.time()

    def callback(outdata, frames, _time_info, status):
        nonlocal phase_l, phase_r
        if status:
            pass

        now = time.time()
        elapsed = now - start_time

        if use_ramp:
            beat_hz = _compute_ramped_beat_hz(elapsed, start_beat_hz, end_beat_hz, ramp_s)
            lf = carrier_hz - (beat_hz / 2.0)
            rf = carrier_hz + (beat_hz / 2.0)
        else:
            lf = left_frequency
            rf = right_frequency

        lf = max(0.0, float(lf))
        rf = max(0.0, float(rf))

        t = np.arange(frames, dtype=np.float64) / sample_rate

        wl = 2.0 * np.pi * lf
        wr = 2.0 * np.pi * rf
        phase_vec_l = phase_l + wl * t
        phase_vec_r = phase_r + wr * t

        phase_l = (phase_l + wl * (frames / sample_rate)) % (2.0 * np.pi)
        phase_r = (phase_r + wr * (frames / sample_rate)) % (2.0 * np.pi)

        left = left_volume * waveforms[left_waveform](phase_vec_l)
        right = right_volume * waveforms[right_waveform](phase_vec_r)

        stereo = np.column_stack((left, right))
        stereo = soft_limiter(stereo, drive=2.5).astype(np.float32, copy=False)

        outdata[:] = stereo

    stream = sd.OutputStream(
        samplerate=sample_rate,
        channels=2,
        dtype="float32",
        callback=callback,
        blocksize=0
    )
    stream.start()

def play_audio():
    global is_playing, stream
    global play_mode, play_start_time
    global ramp_carrier_hz, ramp_start_beat_hz, ramp_end_beat_hz, ramp_duration_s
    global manual_left_hz, manual_right_hz

    if is_playing:
        stop_audio()

    sample_rate = 44100

    left_volume = clamp(float(left_volume_entry.get()) / 100.0, 0.0, 1.0)
    right_volume = clamp(float(right_volume_entry.get()) / 100.0, 0.0, 1.0)

    left_waveform = left_waveform_var.get()
    right_waveform = right_waveform_var.get()

    use_ramp = bool(ramp_enabled_var.get())
    play_start_time = time.time()

    if use_ramp:
        play_mode = "ramp"

        ramp_carrier_hz = float(carrier_entry.get())
        ramp_start_beat_hz = float(start_beat_entry.get())
        ramp_end_beat_hz = float(end_beat_entry.get())
        ramp_duration_s = max(0.0, float(ramp_minutes_entry.get()) * 60.0)

        beat_now = ramp_start_beat_hz
        left_frequency_entry.delete(0, tk.END)
        right_frequency_entry.delete(0, tk.END)
        left_frequency_entry.insert(0, str(ramp_carrier_hz - beat_now / 2.0))
        right_frequency_entry.insert(0, str(ramp_carrier_hz + beat_now / 2.0))

        _start_stream(
            sample_rate=sample_rate,
            left_volume=left_volume,
            right_volume=right_volume,
            left_waveform=left_waveform,
            right_waveform=right_waveform,
            use_ramp=True,
            left_frequency=0.0,
            right_frequency=0.0,
            carrier_hz=ramp_carrier_hz,
            start_beat_hz=ramp_start_beat_hz,
            end_beat_hz=ramp_end_beat_hz,
            ramp_minutes=(ramp_duration_s / 60.0)
        )
    else:
        play_mode = "manual"

        manual_left_hz = float(left_frequency_entry.get())
        manual_right_hz = float(right_frequency_entry.get())

        _start_stream(
            sample_rate=sample_rate,
            left_volume=left_volume,
            right_volume=right_volume,
            left_waveform=left_waveform,
            right_waveform=right_waveform,
            use_ramp=False,
            left_frequency=manual_left_hz,
            right_frequency=manual_right_hz,
            carrier_hz=0.0,
            start_beat_hz=0.0,
            end_beat_hz=0.0,
            ramp_minutes=0.0
        )

    is_playing = True

def stop_audio():
    global is_playing, stream
    global play_mode

    if stream is not None:
        try:
            stream.stop()
        except Exception:
            pass
        try:
            stream.close()
        except Exception:
            pass
        stream = None

    is_playing = False
    play_mode = "manual"

